diff --git a/src/toolbar.c b/src/toolbar.c
index 01a005b..dfd8a19 100644
--- a/src/toolbar.c
+++ b/src/toolbar.c
@@ -34,6 +34,49 @@
 #include "main.h"
 #include "mainwindow.h"
 #include "summaryview.h"
+#include "quicksearch.h"
+
+static void lumina_apply_pill_style(GtkWidget *widget, gpointer user_data)
+{
+	gboolean is_primary = GPOINTER_TO_INT(user_data);
+
+	if (GTK_IS_BUTTON(widget)) {
+		GtkStyleContext *ctx = gtk_widget_get_style_context(widget);
+		gtk_style_context_add_class(ctx, "lumina-pill-btn");
+		if (is_primary)
+			gtk_style_context_add_class(ctx, "lumina-primary-action");
+	} else if (GTK_IS_CONTAINER(widget)) {
+		gtk_container_foreach(GTK_CONTAINER(widget), lumina_apply_pill_style, user_data);
+	}
+}
+
+static void lumina_toolbar_search_changed_cb(GtkSearchEntry *entry, gpointer data)
+{
+	MainWindow *mainwin = (MainWindow *)data;
+	const gchar *text;
+
+	if (!mainwin || !mainwin->summaryview || !mainwin->summaryview->quicksearch)
+		return;
+
+	text = gtk_entry_get_text(GTK_ENTRY(entry));
+	quicksearch_set(mainwin->summaryview->quicksearch,
+			ADVANCED_SEARCH_EXTENDED, text);
+}
+
+static void lumina_toolbar_search_activate_cb(GtkEntry *entry, gpointer data)
+{
+	MainWindow *mainwin = (MainWindow *)data;
+	GtkWidget *qs_entry;
+
+	if (!mainwin || !mainwin->summaryview || !mainwin->summaryview->quicksearch)
+		return;
+
+	qs_entry = quicksearch_get_entry(mainwin->summaryview->quicksearch);
+	if (qs_entry) {
+		gtk_entry_set_text(GTK_ENTRY(qs_entry), gtk_entry_get_text(entry));
+		gtk_widget_activate(qs_entry);
+	}
+}

diff --git a/src/mainwindow.c b/src/mainwindow.c
index 87f8c06..250e371 100644
--- a/src/mainwindow.c
+++ b/src/mainwindow.c
@@ -38,6 +38,42 @@
 #include "foldersel.h"
 #include "quicksearch.h"
 #include "summaryview.h"
+
+static void lumina_load_safari_theme(void)
+{
+	GtkCssProvider *provider = gtk_css_provider_new();
+	GError *error = NULL;
+	gchar *user_css = g_build_filename(get_rc_dir(), "lumina-safari.css", NULL);
+	gchar *sys_css = NULL;
+	const gchar *css_path = NULL;
+
+#ifdef G_OS_WIN32
+	gchar *exe_dir = g_win32_get_package_installation_directory_of_module(NULL);
+	sys_css = g_build_filename(exe_dir, "share", "lumina-mail", "themes", "lumina-safari.css", NULL);
+	g_free(exe_dir);
+#else
+	sys_css = g_build_filename(DATADIR, "lumina-mail", "themes", "lumina-safari.css", NULL);
+#endif
+
+	if (g_file_test(user_css, G_FILE_TEST_EXISTS))
+		css_path = user_css;
+	else if (g_file_test(sys_css, G_FILE_TEST_EXISTS))
+		css_path = sys_css;
+
+	if (css_path && gtk_css_provider_load_from_path(provider, css_path, &error)) {
+		gtk_style_context_add_provider_for_screen(
+			gdk_screen_get_default(),
+			GTK_STYLE_PROVIDER(provider),
+			GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+	} else if (error) {
+		g_warning("Lumina CSS load error: %s", error->message);
+		g_clear_error(&error);
+	}
+
+	g_object_unref(provider);
+	g_free(user_css);
+	g_free(sys_css);
+}

#include <winver.h>
#include <winuser.h>

1 ICON "luminamail.ico"
1 RT_MANIFEST "luminamail.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION        @MAJOR_VERSION@,@MINOR_VERSION@,@MICRO_VERSION@,@EXTRA_VERSION@
PRODUCTVERSION     @MAJOR_VERSION@,@MINOR_VERSION@,@MICRO_VERSION@,@EXTRA_VERSION@
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
FILEFLAGS          0x0L
FILEOS             VOS_NT_WINDOWS32
FILETYPE           VFT_APP
FILESUBTYPE        0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Lumina Mail Open Source Project"
			VALUE "FileDescription", "Lumina Mail"
			VALUE "FileVersion", "@VERSION@"
			VALUE "InternalName", "luminamail"
			VALUE "LegalCopyright", "GPL-3.0-or-later"
			VALUE "OriginalFilename", "luminamail.exe"
			VALUE "ProductName", "Lumina Mail"
			VALUE "ProductVersion", "@GIT_VERSION@ for Windows"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
